# ==============================================================
# SideQuest Frontend Environment Variables
# Copy this file to .env.local and fill in the values
# ==============================================================

# Groq API Key for AI features (PPT evaluation, repo chatbot, helpline AI)
# Get your key from https://console.groq.com → API Keys
VITE_GROQ_API_KEY=

# Use the connected Express preview. Set django to run the legacy interface.
VITE_BACKEND_MODE=express
# Leave empty in development to use Vite's proxy to Express on port 8000.
# In production, set your Express origin or configure /api and /media rewrites.
VITE_API_URL=
