{
  "name": "hackmanager-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "import:legacy": "tsx scripts/importLegacyData.ts",
    "account:create": "tsx scripts/createAccount.ts",
    "test:browser-server": "tsx scripts/startBrowserTestServer.ts",
    "seed": "tsx scripts/seedAccounts.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "11.8.1",
    "cors": "2.8.5",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "7.6.12",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.16.5",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.1.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
